# Contract 1: GM endpoint (Arav -> Rithvik). OpenAI-compatible.
GM_BASE_URL=https://...        # from River
GM_MODEL=gm-v1
GM_API_KEY=                    # River key; real value goes in .env, never committed

# Open teacher model that writes training data (C2, C3). OpenAI-compatible.
# Must be open-weight: Claude and GPT outputs are never used for training.
TEACHER_BASE_URL=https://...   # River base model endpoint, or https://openrouter.ai/api/v1
TEACHER_MODEL=                 # an open-weight model id, e.g. a Qwen model
TEACHER_API_KEY=               # real value goes in .env, never committed

# Untrained base model GM is fine-tuned from (benchmark only). OpenAI-compatible.
BASE_BASE_URL=https://...      # River base model endpoint
BASE_MODEL=                    # the same base GM was trained on
BASE_API_KEY=                  # real value goes in .env, never committed
