# Contract 1: GM endpoint (Arav -> Rithvik). OpenAI-compatible.
GM_BASE_URL=https://...        # from River
GM_MODEL=gm-v1
GM_API_KEY=                    # River key; real value goes in .env, never committed

# Part 1 -> GM Nightly Loop. The base must be identical in both parts.
GM_BASE_MODEL=Qwen/Qwen3.5-9B
GM_CHECKPOINT=                 # River training checkpoint produced by Part 1
GM_LORA_RANK=16                # must match the Part 1 adapter
RIVER_API_KEY=                 # server-side only; never install on employee Macs
